# Baazi — copy to .env.local and fill in. Local play works without any of this.

# Supabase (online tables and coin wallets; required for tables on Vercel). Run supabase/migrations/*.sql
# in order first. Without these keys, tables use this server's memory (local network play only).
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
